{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-main.ps1\"",
            "timeout": 10,
            "statusMessage": "Checking branch..."
          }
        ]
      }
    ]
  }
}
